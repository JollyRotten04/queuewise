# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection for the app's own database user (see README.md for setup).
DATABASE_URL=postgres://queuewise:CHANGE_ME@localhost:5432/queuewise

PORT=4000

# Origin(s) of the Next.js frontend, comma-separated. Used to reject cross-site writes and to build reset links.
APP_ORIGIN=http://localhost:3000

# Send cookies only over HTTPS. Defaults to true when NODE_ENV=production. Keep false only for local http.
COOKIE_SECURE=false

# Which proxies to trust for the client IP (rate limiting). "loopback" fits the Next.js rewrite on the same machine.
TRUST_PROXY=loopback

# Visitor names and phone numbers are erased from tickets older than this many days.
DATA_RETENTION_DAYS=30

# Timezone for new branches (IANA name).
DEFAULT_TIMEZONE=Asia/Manila

# Optional: npm run db:seed creates this demo admin for the "main" branch when both are set (password: 12+ characters).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
